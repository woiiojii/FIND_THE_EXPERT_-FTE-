# Convex Deployment URL (Optional - aplikasi sudah memiliki mode reactive lokal otomatis jika belum dihubungkan ke cloud)
# NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Google Maps API Key (Opsional - Leaflet & OpenStreetMap sudah aktif secara default)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
